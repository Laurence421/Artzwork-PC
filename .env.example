# Copy to .env.local and fill in from Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The database password goes in a separate file, .env.db (only npm run db:push reads it):
#   SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Two sites, one app: requests to SELLER_HOST are the seller site, everything else is the shop.
# Locally the seller site is http://admin.localhost:3000 (works in Chrome, Edge and Firefox).
SELLER_HOST=admin.localhost:3000
SHOP_URL=http://localhost:3000
SELLER_URL=http://admin.localhost:3000
# Where the seller gets "New order" and "Payment sent" emails (needs RESEND_API_KEY). Empty: the contact email in Branding.
ORDER_ALERT_EMAIL=
# Online payments (GCash / online banking redirect). PAYMENT_CONFIRM_SECRET: long random value, also stored in
# the database (private.config payment_confirm_secret). Without PayMongo keys, a test payment page is used locally.
PAYMENT_CONFIRM_SECRET=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Optional: which online banks PayMongo offers (default: dob,dob_ubp = BPI, UnionBank).
PAYMONGO_BANK_METHODS=
# Free automatic payment check: the shop phone forwards its GCash / bank SMS to /api/payments/sms?key=SMS_WEBHOOK_KEY
# (long random value). Optional SMS_ALLOWED_SENDERS, e.g. GCash,BPI,BDO.
SMS_WEBHOOK_KEY=
SMS_ALLOWED_SENDERS=

# Order emails (optional). Off until both are set. Get a key at resend.com; EMAIL_FROM must use a
# domain you have verified there, e.g. "Artzwork PC <orders@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

